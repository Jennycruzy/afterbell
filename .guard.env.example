# Optional P4 corporate-action lookahead credentials.
#
# This file is a template only. Copy it to /home/ubuntu/afterbell/.guard.env
# with mode 600 on the VPS if you choose to enable Alpaca's read-only
# corporate-action lookahead. It is separate from .env so the recorder never
# receives it and the authenticated Binance token is never loaded by the guard.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
