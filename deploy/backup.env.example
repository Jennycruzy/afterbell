# Copy to /etc/afterbell/backup.env with mode 600.
# The job skips hot files, verifies stable data, and only removes old local
# raw archives after an exact remote check.
AFTERBELL_BACKUP_REMOTE=
AFTERBELL_BACKUP_MIN_AGE=2m
AFTERBELL_BACKUP_RETENTION_DAYS=14
# rclone may refresh its OAuth token. Keep this file mode 600 in a directory
# writable by ubuntu; /etc is read-only under the backup systemd sandbox.
RCLONE_CONFIG=/home/ubuntu/.config/rclone/rclone.conf
