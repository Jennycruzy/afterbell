[Unit]
Description=AFTERBELL recorder-data backup
After=network-online.target afterbell-recorder.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/afterbell
EnvironmentFile=-/etc/afterbell/backup.env
ExecStart=/home/ubuntu/afterbell/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/afterbell/data
