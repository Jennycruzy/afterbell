[Unit]
Description=AFTERBELL recorder-data backup
After=network-online.target afterbell-recorder.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/afterbell
EnvironmentFile=-/etc/afterbell/backup.env
Environment=HOME=/home/ubuntu
ExecStart=/usr/local/libexec/afterbell-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/afterbell/data /home/ubuntu/.config/rclone
