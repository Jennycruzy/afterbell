[Unit]
Description=AFTERBELL unauthenticated market-data recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/afterbell
Environment=PYTHONUNBUFFERED=1
Environment=REFERENCE_PROVIDER=yahoo
ExecStart=/home/ubuntu/afterbell/.venv/bin/python -m afterbell.recorder
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/afterbell/data

[Install]
WantedBy=multi-user.target
