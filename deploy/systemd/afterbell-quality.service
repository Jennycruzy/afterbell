[Unit]
Description=AFTERBELL local code-quality verification
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/afterbell
ExecStart=/home/ubuntu/afterbell/scripts/qualitycheck.sh
Nice=10
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
